# Lenovo K8 / Brady stock-style properties
persist.service.adb.enable=1
persist.service.debuggable=1
persist.sys.usb.config=mass_storage,adb

# RIL
rild.libpath=mtk-ril.so
rild.libargs=-d /dev/ttyC0
ro.telephony.ril_class=MT6757
ro.telephony.default_network=10,10

# Wi-Fi
wifi.interface=wlan0
ro.mediatek.wlan.wsc=1
ro.mediatek.wlan.p2p=1
mediatek.wlan.ctia=0
wifi.tethering.interface=ap0
wifi.direct.interface=p2p0

# Graphics / display
ro.opengles.version=196610
ro.sf.lcd_density=320
persist.sys.lcd_density=320
qemu.hw.mainkeys=1

# USB
ro.sys.usb.mtp.whql.enable=0
sys.ipo.pwrdncap=2
ro.sys.usb.storage.type=mtp
ro.sys.usb.bicr=no
ro.sys.usb.charging.only=yes

# Audio / camera
ro.camera.sound.forced=0
ro.audio.silent=0
ro.zygote.preload.enable=0

# Performance
ro.mtk_perf_simple_start_win=1
ro.mtk_perf_fast_start_win=1
ro.mtk_perf_response_time=1
ro.board.platform=mt6757
ro.build.product=brady
ro.product.device=brady
ro.product.model=Lenovo K8
ro.product.brand=Lenovo
ro.product.name=brady
ro.product.manufacturer=LENOVO
